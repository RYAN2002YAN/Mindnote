# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI API Keys (optional — can also be set in-app via Settings)
# OpenAI Whisper for transcription
# (stored client-side in localStorage as mindnote_openai_key)
# OPENAI_API_KEY=sk-...

# DeepSeek V4 for note structuring
# (stored client-side in localStorage as mindnote_ai_key)
# DEEPSEEK_API_KEY=sk-...
